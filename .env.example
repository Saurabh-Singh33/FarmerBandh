# ====================================================================
# FarmerBandh - Master Environment Example Template
# This file is safe to commit to GitHub as a reference template.
# Copy this file to .env and fill in your real credentials locally.
# ====================================================================

# 1. Platform Super Administrator Credentials
ADMIN_EMAIL=admin@farmerbandh.com
ADMIN_PASSWORD=SetYourSecureAdminPasswordHere!

# 2. Database Connection (MySQL)
DB_CONNECTION_STRING=Server=localhost;Port=3307;Database=FarmerBandhDb;User=root;Password=your_password;

# 3. JWT Authentication Security (Minimum 32 characters)
JWT_KEY=ChangeThisToYourCustomSecretKeyWithAtLeast32BytesLength!
JWT_ISSUER=FarmerBandh
JWT_AUDIENCE=FarmerBandh
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# 4. Frontend API Connection URL
VITE_API_BASE_URL=http://localhost:5000/api/v1
