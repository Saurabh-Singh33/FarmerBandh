# ====================================================================
# FarmerBandh Server - Environment Example Template
# Safe to commit to GitHub.
# Copy this file to .env and configure your local values.
# ====================================================================

# 1. Super Admin Credentials (Seed & Synchronization)
ADMIN_EMAIL=admin@farmerbandh.com
ADMIN_PASSWORD=SetYourSecureAdminPasswordHere!

# 2. Database Connection (MySQL on Port 3307)
DB_CONNECTION_STRING=Server=localhost;Port=3307;Database=FarmerBandhDb;User Id=root;Password=mysqlpassword;

# 3. JWT Authentication Security (Minimum 32 characters)
JWT_KEY=ChangeThisToYourCustomSecretKeyWithAtLeast32BytesLength!
JWT_ISSUER=FarmerBandh
JWT_AUDIENCE=FarmerBandh
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# 4. OpenRouter AI Multilingual Chatbot
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# ====================================================================
# 5. Direct Contact Form & Admin Email Delivery (SMTP)
# ====================================================================
# When anyone sends a message on the Contact Us page, an email alert
# will be sent directly to this Admin inbox:
ADMIN_NOTIFICATION_EMAIL=admin@farmerbandh.com

# SMTP Host Server
# - For Gmail: smtp.gmail.com
# - For Outlook/Hotmail: smtp.office365.com
# - For Yahoo: smtp.mail.yahoo.com
# - For Brevo / Sendinblue: smtp-relay.brevo.com
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, or 465 for SSL)
SMTP_PORT=587

# SMTP Username / Login Email (Usually your Gmail/Outlook address)
SMTP_USER=your-email@gmail.com

# SMTP Password
# IMPORTANT FOR GMAIL:
# Do NOT use your normal account password.
# 1. Go to Google Account (myaccount.google.com) -> Security.
# 2. Enable "2-Step Verification" if not already enabled.
# 3. Go to "App Passwords" (or search "App Passwords" in Google settings).
# 4. Create a new App Password named "FarmerBandh".
# 5. Paste the 16-character code here (e.g. abcd efgh ijkl mnop):
SMTP_PASS=your-16-character-app-password

# Enable SSL/TLS encryption (true for Gmail / Outlook)
SMTP_ENABLE_SSL=true

# Sender details appearing in the "From:" header
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="FarmerBandh Operations Desk"
