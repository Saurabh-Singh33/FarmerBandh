# ====================================================================
# FarmerBandh Server - Environment Example Template
# Safe to commit to GitHub.
# Copy this file to .env and configure your local values.
# ====================================================================

ADMIN_EMAIL=admin@farmerbandh.com
ADMIN_PASSWORD=SetYourSecureAdminPasswordHere!

DB_CONNECTION_STRING=Server=localhost;Port=3307;Database=FarmerBandhDb;User=root;Password=root;

JWT_KEY=ChangeThisToYourCustomSecretKeyWithAtLeast32BytesLength!
JWT_ISSUER=FarmerBandh
JWT_AUDIENCE=FarmerBandh
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
